            <tr><td>Notes on Distant Stars</td><td>salma.k</td><td>Aug 25, 2026</td><td>Sep 9, 2026</td><td><span class="badge badge-rose">Overdue</span></td></tr>
            <tr><td>Debugging Yourself</td><td>youssef92</td><td>Jul 30, 2026</td><td>Aug 13, 2026</td><td><span class="badge badge-sage">Returned</span></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ---- Reservations ---- -->
    <section class="page" id="page-reservations">
      <div class="page-head">
        <div><h1>Reservations</h1><p>Members waiting on a title that's currently out.</p></div>
        <button class="btn btn-oak">+ New reservation</button>
      </div>
      <div class="panel">
        <table>
          <thead><tr><th>Book</th><th>Member</th><th>Reserved on</th><th>Status</th></tr></thead>
          <tbody>
            <tr><td>The Cartographer's Dream</td><td>salma.k</td><td>Sep 5, 2026</td><td><span class="badge badge-oak">Waiting</span></td></tr>
            <tr><td>A Short History of Salt</td><td>mahmoud_h</td><td>Sep 1, 2026</td><td><span class="badge badge-sage">Ready for pickup</span></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ---- Fines ---- -->
    <section class="page" id="page-fines">
      <div class="page-head">
        <div><h1>Fines</h1><p>Outstanding and settled charges.</p></div>
      </div>
      <div class="panel">
        <table>
          <thead><tr><th>Member</th><th>Loan</th><th>Amount</th><th>Issued</th><th>Status</th></tr></thead>
          <tbody>
            <tr><td>salma.k</td><td>Notes on Distant Stars</td><td>EGP 15.00</td><td>Sep 10, 2026</td><td><span class="badge badge-rose">Unpaid</span></td></tr>
            <tr><td>youssef92</td><td>Debugging Yourself</td><td>EGP 30.00</td><td>Aug 14, 2026</td><td><span class="badge badge-sage">Paid</span></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ---- Reviews ---- -->
    <section class="page" id="page-reviews">
      <div class="page-head">
        <div><h1>Reviews</h1><p>What members are saying about the collection.</p></div>
      </div>
      <div class="grid">
        <div class="info-card"><div class="stars">★★★★★</div><h3 style="margin-top:8px;">The Quiet Ledger</h3><p>"Made a subject I usually avoid feel completely readable." — mahmoud_h</p></div>
        <div class="info-card"><div class="stars">★★★★☆</div><h3 style="margin-top:8px;">A Short History of Salt</h3><p>"Slow start, but the last third is worth it." — youssef92</p></div>
        <div class="info-card"><div class="stars">★★★☆☆</div><h3 style="margin-top:8px;">Notes on Distant Stars</h3><p>"Dense in places, but I learned a lot." — salma.k</p></div>
      </div>
    </section>

    <!-- ---- Auth (Login / Sign up) ---- -->
    <section class="page" id="page-auth">
      <div class="auth-wrap">
        <div class="auth-brand">
          <div>
            <span class="brand-mark" style="font-size:26px;">Folio</span>
          </div>
          <div>
            <h2>A library is a record of what a place decided was worth keeping.</h2>
            <div class="quote-attr">— from the front desk</div>
          </div>
        </div>

        <div class="auth-right">
          <div class="auth-card">
            <div class="auth-tabs">
              <button class="auth-tab active" onclick="showAuthForm('login')">Sign in</button>
              <button class="auth-tab" onclick="showAuthForm('signup')">Sign up</button>
            </div>

            <form class="auth-form active" id="form-login" onsubmit="return false;">
              <div class="field"><label>Email</label><input type="email" placeholder="you@mail.com" /></div>
              <div class="field"><label>Password</label><input type="password" placeholder="••••••••" /></div>
              <button class="btn btn-oak auth-submit" type="submit">Sign in</button>
              <div class="auth-foot">New here? <a onclick="showAuthForm('signup')">Create an account</a></div>
            </form>

            <form class="auth-form" id="form-signup" onsubmit="return false;">
              <div class="field"><label>Username</label><input type="text" placeholder="yourname" /></div>
              <div class="field"><label>Email</label><input type="email" placeholder="you@mail.com" /></div>
              <div class="field"><label>Phone number</label><input type="tel" placeholder="01xxxxxxxxx" /></div>
              <div class="field"><label>Password</label><input type="password" placeholder="••••••••" /></div>
              <button class="btn btn-oak auth-submit" type="submit">Create account</button>
              <div class="auth-foot">Already a member? <a onclick="showAuthForm('login')">Sign in</a></div>
            </form>
          </div>
        </div>
      </div>
    </section>
        @RenderBody()
  </main>

<script>
  function showPage(id){
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById('page-' + id).classList.add('active');
    document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
    const btn = document.querySelector('.nav-item[data-page="' + id + '"]');
    if(btn) btn.classList.add('active');
  }
  document.querySelectorAll('.nav-item[data-page]').forEach(btn=>{
    btn.addEventListener('click', ()=> showPage(btn.dataset.page));
  });

  function showAuthForm(which){
    document.querySelectorAll('.auth-form').forEach(f => f.classList.remove('active'));
    document.getElementById('form-' + which).classList.add('active');
    document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.auth-tab')[which === 'login' ? 0 : 1].classList.add('active');
  }
</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
